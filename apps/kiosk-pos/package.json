{
  "name": "kiosk-pos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --pool threads",
    "smoke:live": "node scripts/live-odoo-smoke.mjs",
    "smoke:simulation": "node scripts/simulation-smoke.mjs",
    "simulation:audit": "vitest run src/simulation/peakSimulation.test.ts --pool threads",
    "gate:wiring": "node scripts/wiring-gate.mjs",
    "verify": "npm test && npm run gate:wiring && npm run build",
    "verify:controls": "node scripts/demo-verify/verify-contrast.mjs && node scripts/demo-verify/verify-controls-ui.mjs",
    "verify:live": "npm run verify && node scripts/demo-verify/verify-accounting.mjs && node scripts/demo-verify/verify-finance-vs-ledger.mjs && node scripts/demo-verify/accountant-audit.mjs && npm run verify:controls && npm run smoke:live",
    "demo:verify:full": "node scripts/demo-verify/run-all.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "playwright": "^1.59.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.1.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.14.5",
    "@assistant-ui/react-markdown": "^0.14.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "assistant-stream": "^0.3.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.16.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "simple-icons": "^16.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-shimmer": "^0.4.11",
    "zustand": "^5.0.13"
  }
}
