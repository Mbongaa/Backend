<odoo>
  <record id="bayaan_product_template_form_inherit" model="ir.ui.view">
    <field name="name">bayaan.product.template.form.inherit</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_only_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='type']" position="after">
        <field name="bayaan_consumption_mode"/>
        <field name="bayaan_stock_target_qty"/>
        <field name="bayaan_stock_reorder_qty"/>
        <field name="bayaan_stock_critical_qty"/>
        <field name="bayaan_stock_max_qty"/>
        <field name="bayaan_stock_priority_weight"/>
      </xpath>
    </field>
  </record>
</odoo>
