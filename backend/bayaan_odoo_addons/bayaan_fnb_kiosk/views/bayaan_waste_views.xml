<odoo>
  <record id="bayaan_waste_action" model="ir.actions.act_window">
    <field name="name">Waste &amp; Loss</field>
    <field name="res_model">bayaan.waste.entry</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="bayaan_waste_view_list" model="ir.ui.view">
    <field name="name">bayaan.waste.entry.list</field>
    <field name="model">bayaan.waste.entry</field>
    <field name="arch" type="xml">
      <list decoration-success="state == 'posted'">
        <field name="create_date"/>
        <field name="kiosk_id"/>
        <field name="product_id"/>
        <field name="qty"/>
        <field name="reason"/>
        <field name="estimated_cost"/>
        <field name="state"/>
      </list>
    </field>
  </record>

  <record id="bayaan_waste_view_form" model="ir.ui.view">
    <field name="name">bayaan.waste.entry.form</field>
    <field name="model">bayaan.waste.entry</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_post" type="object" string="Post Waste" class="btn-primary" invisible="state == 'posted'"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <group>
            <field name="kiosk_id"/>
            <field name="product_id"/>
            <field name="qty"/>
            <field name="reason"/>
            <field name="estimated_cost"/>
          </group>
          <field name="scrap_ids" readonly="1"/>
        </sheet>
      </form>
    </field>
  </record>

  <menuitem id="bayaan_waste_menu" name="Waste &amp; Loss" parent="bayaan_root_menu" action="bayaan_waste_action" sequence="30"/>
</odoo>
